# ── Required ────────────────────────────────────────────────
# Default provider. Free OpenRouter models work with just this key.
OPENROUTER_API_KEY=

# ── Unlock every non-free model ─────────────────────────────
# Any long random string. Without it, only OpenRouter ":free" models can be used.
# The app asks for it once (stored in the browser) when you pick a locked model.
APP_ACCESS_KEY=

# ── Optional providers — set a key and its models appear in the picker ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# ── Optional ────────────────────────────────────────────────
# Model selected on first visit (format: provider:model-id)
# DEFAULT_MODEL=openrouter:cohere/north-mini-code:free

# Any other OpenAI-compatible endpoint (JSON array). Add "noKey": true if it needs no key.
# EXTRA_PROVIDERS=[{"id":"together","name":"Together","base":"https://api.together.xyz/v1","keyEnv":"TOGETHER_API_KEY"}]
